# Impostare come segreti esclusivamente nell'ambiente del backend.
OPENAI_API_KEY=
OPENAI_PAYSLIP_MODEL=gpt-4.1-mini

# Protezioni del solo endpoint AI (valori predefiniti; nessuna credenziale).
AI_MAX_UPLOAD_BYTES=15728640
AI_MULTIPART_OVERHEAD_BYTES=16384
AI_RATE_LIMIT_REQUESTS=6
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_CLIENTS_MAX=10000
AI_MAX_CONCURRENT_ANALYSES=2
AI_DAILY_ANALYSIS_LIMIT=200
# Lasciare vuoto finché gli IP dei proxy Render e la catena X-Forwarded-For
# non sono stati verificati. Separare eventuali reti/IP attendibili con virgole.
AI_TRUSTED_PROXY_CIDRS=

# Configurazione backend esistente.
MONGO_URL=mongodb://localhost:27017
DB_NAME=shift_tracker
CORS_ORIGINS=http://localhost:3000,https://cedolino-chiaro-1-0-integration.otellobruno76.chatgpt.site
